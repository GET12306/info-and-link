    "preview": "npm run build && wrangler dev",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:calendar": "node --test tests/activityCalendar.test.mjs",
    "test:editor": "node --test tests/activityEditor.test.mjs",
    "test:resources-editor": "node --test tests/resourceEditor.test.mjs",
    "test:tickets": "node --test tests/ticketStatus.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "date-fns": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.2",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
